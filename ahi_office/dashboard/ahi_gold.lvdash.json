{
 "datasets": [
  {
   "name": "pif",
   "displayName": "Policies in force",
   "queryLines": [
    "SELECT f.as_of_date, f.profit_centre, f.line_of_business, f.policy_count, f.written_premium, ",
    "       p.producer_name, v.provider_name, v.provider_type ",
    "FROM ahi_dev.gold.fct_policies_in_force f ",
    "JOIN ahi_dev.gold.dim_producer p ON p.producer_id = f.producer_id ",
    "JOIN ahi_dev.gold.dim_provider v ON v.provider_id = f.provider_id ",
    "WHERE f.as_of_date = (SELECT max(as_of_date) FROM ahi_dev.gold.fct_policies_in_force)"
   ]
  },
  {
   "name": "masters",
   "displayName": "Master counts",
   "queryLines": [
    "SELECT (SELECT count(*) FROM ahi_dev.gold.dim_producer WHERE producer_id <> 'PRD-UNKNOWN') AS producers, ",
    "       (SELECT count(*) FROM ahi_dev.gold.dim_provider WHERE provider_id <> 'PRV-UNKNOWN') AS providers, ",
    "       (SELECT count(*) FROM ahi_dev.gold.dim_policy) AS policy_terms"
   ]
  },
  {
   "name": "abc",
   "displayName": "ABC control log",
   "queryLines": [
    "SELECT started_at, hop, profit_centre, entity, regexp_extract(source_name, '[^/]+$', 0) AS source, ",
    "       rows_in, rows_out, rows_rejected, status, notes FROM ahi_dev.ops.abc_control_log"
   ]
  },
  {
   "name": "dq",
   "displayName": "Data quality findings",
   "queryLines": [
    "SELECT checked_at, hop, profit_centre, entity, rule, action, rows_checked, rows_failed, status ",
    "FROM ahi_dev.ops.dq_results WHERE rows_failed > 0"
   ]
  }
 ],
